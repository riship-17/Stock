# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/stocktracker
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/stocktracker?retryWrites=true&w=majority

# Cache TTL
PRICE_CACHE_TTL_MINUTES=2       # Refresh live prices every N minutes
HISTORY_CACHE_TTL_MINUTES=60   # Refresh historical data every N minutes

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Finnhub API (https://finnhub.io) — used for market news feed
# Without this key, the news feed shows built-in mock market news
FINNHUB_API_KEY=

# Optional: NewsAPI (https://newsapi.org) — alternative news source
NEWSAPI_KEY=
 